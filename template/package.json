{
	"name": "{{PACKAGE_NAME}}",
	"version": "0.1.0",
	"description": "{{DESCRIPTION}}",
	"keywords": [
		"opencode",
		"opencode-plugin",
		"plugin"
	],
	"license": "MIT",
	"author": "{{AUTHOR}}",
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./gui-experimental": "./dist/gui-experimental.cjs"
	},
	"main": "src/index.ts",
	"files": [
		"src",
		"dist"
	],
	"scripts": {
		"check": "bun run format && bun run lint:fix && bun run typecheck",
		"dev": "bun run dev.ts",
		"build:gui": "vite build",
		"dev:gui": "vite build --watch",
		"format": "prettier . --write",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"setup": "bun run setup.ts",
		"typecheck": "tsc --noEmit",
		"unregister": "bun run unregister.ts"
	},
	"dependencies": {
		"@opencode/plugin": "{{OPENCODE_PLUGIN_VERSION}}",
		"@opencode/sdk": "{{OPENCODE_SDK_VERSION}}",
		"effect": "^3.16.0"
	},
	"devDependencies": {
		"@clack/prompts": "^1.7.0",
		"@eslint/js": "^10.0.1",
		"@types/bun": "^1.3.14",
		"@types/node": "^22.0.0",
		"electron": "^33.0.0",
		"eslint": "^10.8.0",
		"prettier": "^3.9.6",
		"solid-js": "^1.9.0",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.65.0",
		"vite": "^7.0.0",
		"vite-plugin-solid": "^2.11.0"
	}
}
