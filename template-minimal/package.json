{
	"name": "{{PACKAGE_NAME}}",
	"version": "0.1.0",
	"description": "{{DESCRIPTION}}",
	"keywords": [
		"opencode",
		"opencode-plugin",
		"plugin"
	],
	"license": "MIT",
	"author": "{{AUTHOR}}",
	"type": "module",
