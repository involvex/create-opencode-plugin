		"lint:fix": "eslint . --fix",
		"setup": "bun run setup.ts",
		"typecheck": "tsc --noEmit",
		"unregister": "bun run unregister.ts"
	},
	"dependencies": {
		"@opencode-ai/plugin": "{{OPENCODE_PLUGIN_VERSION}}",
		"@opencode-ai/sdk": "{{OPENCODE_SDK_VERSION}}"
	},
	"devDependencies": {
		"@clack/prompts": "^1.7.0",
		"@eslint/js": "^10.0.1",
		"@types/bun": "^1.3.14",
		"eslint": "^10.8.0",
		"prettier": "^3.9.6",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.65.0"
	}
